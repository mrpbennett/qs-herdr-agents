#!/usr/bin/env python3
"""Focus a Herdr agent and raise the Herdr terminal window.

Usage: omarchy-herdr-focus <target> [window-class]

The target is anything ``herdr agent focus`` accepts: a unique live agent
name or the pane id currently hosting the agent. The optional second
argument is a terminal window class used as a fallback when the process
tree cannot be inspected — e.g. Herdr running over SSH inside a local
terminal, where no local ``herdr`` process exists.

Four steps:

1. ``herdr agent focus <target>`` moves focus inside the Herdr TUI to the
   agent's workspace, tab, and pane.
2. The Herdr window is located among the compositor's clients (a terminal
   whose process tree runs ``herdr``). When several windows match, a mapped,
   unhidden window on a normal workspace is preferred over special-workspace,
   hidden, or unmapped ones; ties keep compositor order.
3. If that window lives in a special workspace (scratchpad / minimize
   emulation) which no monitor currently displays, it is opened with a
   ``toggle_special`` dispatch first — plain focus does not open hidden
   special workspaces.
4. When no process tree matches but a window class was given, the best-ranked
   client with that class (or initial class) is used instead.

Focusing a window on another workspace switches the active Hyprland
workspace to it, so this works from anywhere on the desktop. When Hyprland
is unavailable or no local window runs herdr (headless/remote Herdr), steps
2–4 are skipped; the in-TUI focus has already been applied.

Exit codes: 0 success, 1 herdr or hyprctl failure, 2 usage error.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from typing import Any, Optional

HERDR: str = os.environ.get("HERDR_BIN", "herdr")
HYPRCTL: str = os.environ.get("HYPRCTL_BIN", "hyprctl")

_HERDR_TIMEOUT: int = 5  # seconds — herdr agent focus is a local server call
_HYPRCTL_TIMEOUT: int = 3  # seconds — hyprctl queries are fast


def run(cmd: list[str], *, timeout: int = 10) -> subprocess.CompletedProcess[str]:
    """Run a command and return the result without raising on non-zero exit."""
    return subprocess.run(cmd, capture_output=True, text=True, check=False,
                          timeout=timeout)


def focus_in_herdr(target: str) -> tuple[bool, str]:
    """Focus the target agent inside the Herdr TUI.

    Returns (ok, detail) where *detail* is stderr on failure.
    """
    out = run([HERDR, "agent", "focus", target], timeout=_HERDR_TIMEOUT)
    if out.returncode != 0:
        detail = "\n".join(part.strip() for part in (out.stdout, out.stderr) if part.strip())
        return False, detail or "herdr agent focus failed"
    return True, ""


def process_has_herdr(pid: int) -> bool:
    """True if the process tree rooted at *pid* contains a process named herdr."""
    seen: set[int] = set()
    stack: list[int] = [pid]
    while stack:
        current = stack.pop()
        if current in seen:
            continue
        seen.add(current)
        try:
            with open(f"/proc/{current}/comm", encoding="utf-8") as handle:
                comm = handle.read().strip()
        except OSError:
            continue
        if comm == "herdr":
            return True
        try:
            task_dir = f"/proc/{current}/task"
            for tid in os.listdir(task_dir):
                try:
                    with open(f"{task_dir}/{tid}/children", encoding="utf-8") as handle:
                        stack.extend(int(child) for child in handle.read().split())
                except OSError:
                    continue
        except OSError:
            continue
    return False


def client_rank(client: dict[str, Any]) -> int:
    """Lower ranks are better jump targets.

    0: mapped, not hidden, on a normal workspace (a plain focus suffices)
    1: mapped, not hidden, inside a special workspace (needs opening first)
    2: mapped but hidden (minimized-style)
    3: unmapped (last resort)
    """
    mapped: bool = bool(client.get("mapped", True))
    if not mapped:
        return 3
    if client.get("hidden", False):
        return 2
    workspace: dict[str, Any] = client.get("workspace") or {}
    name: str = str(workspace.get("name") or "")
    if not name.startswith("special:"):
        return 0
    return 1


def find_herdr_client(
    clients: list[dict[str, Any]] | None,
    is_herdr_window: Any = process_has_herdr,
) -> Optional[dict[str, Any]]:
    """Return the best client window whose process tree runs herdr, or None."""
    matches: list[dict[str, Any]] = []
    for client in clients or []:
        pid = client.get("pid")
        address = client.get("address")
        if pid and address and is_herdr_window(pid):
            matches.append(client)
    if not matches:
        return None
    return min(matches, key=client_rank)


def find_client_by_class(
    clients: list[dict[str, Any]] | None,
    window_class: str,
) -> Optional[dict[str, Any]]:
    """Return the best-ranked client matching *window_class*, or None.

    Fallback for setups where the process tree cannot be inspected (Herdr
    over SSH in a local terminal). Matches class and initialClass
    case-insensitively.
    """
    wanted: str = str(window_class or "").strip().lower()
    if not wanted:
        return None
    matches = [
        client for client in clients or []
        if client.get("address") and any(
            str(client.get(key) or "").strip().lower() == wanted
            for key in ("class", "initialClass")
        )
    ]
    if not matches:
        return None
    return min(matches, key=client_rank)


def hyprctl_clients() -> Optional[list[dict[str, Any]]]:
    """Query the compositor for all clients, or None on failure."""
    out = run([HYPRCTL, "-j", "clients"], timeout=_HYPRCTL_TIMEOUT)
    if out.returncode != 0:
        return None
    try:
        return json.loads(out.stdout)
    except json.JSONDecodeError:
        return None


def hyprctl_monitors() -> Optional[list[dict[str, Any]]]:
    """Query the compositor for all monitors, or None on failure."""
    out = run([HYPRCTL, "-j", "monitors"], timeout=_HYPRCTL_TIMEOUT)
    if out.returncode != 0:
        return None
    try:
        return json.loads(out.stdout)
    except json.JSONDecodeError:
        return None


def ensure_special_visible(client: dict[str, Any]) -> bool:
    """Open the special workspace hosting *client* unless a monitor shows it.

    Returns True when nothing needs doing or the toggle succeeded, and False
    when the state could not be verified (no monitor data) or the dispatch
    failed. Callers may continue with the plain focus either way.
    """
    workspace: dict[str, Any] = client.get("workspace") or {}
    name: str = str(workspace.get("name") or "")
    if not name.startswith("special:"):
        return True
    monitors = hyprctl_monitors()
    if monitors is None:
        # Cannot verify whether it is already shown; leave state untouched.
        return False
    for monitor in monitors or []:
        if ((monitor.get("specialWorkspace") or {}).get("name") or "") == name:
            return True
    special: str = name[len("special:"):]
    if not special:
        return True
    out = run([HYPRCTL, "dispatch",
               f'hl.dsp.workspace.toggle_special("{special}")'],
              timeout=_HYPRCTL_TIMEOUT)
    return out.returncode == 0


def raise_window(address: str) -> tuple[bool, str]:
    """Focus a window by address. If the window lives on another workspace
    the active workspace switches to it (Hyprland 0.56+ dispatch API).

    Returns (ok, detail) where *detail* is stderr on failure.
    """
    out = run([HYPRCTL, "dispatch",
               f'hl.dsp.focus({{ window = "address:{address}" }})'],
              timeout=_HYPRCTL_TIMEOUT)
    if out.returncode != 0:
        detail = "\n".join(part.strip() for part in (out.stdout, out.stderr) if part.strip())
        return False, detail or f"hyprctl dispatch failed for {address}"
    return True, ""


def main(argv: list[str]) -> int:
    if len(argv) not in (1, 2) or not argv[0].strip():
        print(__doc__, file=sys.stderr)
        return 2
    target: str = argv[0].strip()
    window_class: str = argv[1] if len(argv) == 2 else ""

    ok, detail = focus_in_herdr(target)
    herdr_ok: bool = ok
    if not ok:
        print(f"omarchy-herdr-focus: herdr focus: {detail}", file=sys.stderr)

    clients = hyprctl_clients()
    if clients is None:
        # Not running under Hyprland; the in-TUI focus is all we can do.
        return 0 if herdr_ok else 1

    client = find_herdr_client(clients)
    if client is None:
        client = find_client_by_class(clients, window_class)
    if client is None:
        # Headless/remote Herdr; there is no local window to raise.
        return 0 if herdr_ok else 1

    if not ensure_special_visible(client):
        print(f"omarchy-herdr-focus: could not open "
              f"{client.get('workspace', {}).get('name', 'special workspace')}",
              file=sys.stderr)

    ok, detail = raise_window(client["address"])
    if not ok:
        print(f"omarchy-herdr-focus: {detail}", file=sys.stderr)
        return 1 if not herdr_ok else 0
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
