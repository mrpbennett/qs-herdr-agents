#!/usr/bin/env python3
"""Focus a Herdr agent and raise the Herdr terminal window.

Usage: omarchy-herdr-focus <target> [window-class]

The target is anything ``herdr agent focus`` accepts: a unique live agent
name or the pane id currently hosting the agent. The optional second
argument is a terminal window class used as a fallback when the process
tree cannot be inspected — e.g. Herdr running over SSH inside a local
terminal, where no local ``herdr`` process exists.

Four steps:

1. ``herdr agent focus <target>`` moves focus inside the Herdr TUI to the
   agent's workspace, tab, and pane.
2. The Herdr window is located among the compositor's clients (a terminal
   whose process tree runs ``herdr``). When several windows match, a mapped,
   unhidden window on a normal workspace is preferred over special-workspace,
   hidden, or unmapped ones; ties keep compositor order.
3. If that window lives in a special workspace (scratchpad / minimize
   emulation) which no monitor currently displays, it is opened with a
   ``toggle_special`` dispatch first — plain focus does not open hidden
   special workspaces.
4. When no process tree matches but a window class was given, the best-ranked
   client with that class (or initial class) is used instead.

Focusing a window on another workspace switches the active Hyprland
workspace to it, so this works from anywhere on the desktop. When Hyprland
is unavailable or no local window runs herdr (headless/remote Herdr), steps
2–4 are skipped; the in-TUI focus has already been applied.

Exit codes: 0 success, 1 herdr or hyprctl failure, 2 usage error.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

# Add repo root to path so we can import hyprland.py.
_REPO = Path(__file__).resolve().parents[1]
if str(_REPO) not in sys.path:
    sys.path.insert(0, str(_REPO))

from hyprland import HyprlandWindow, _run  # noqa: E402

HERDR: str = os.environ.get("HERDR_BIN", "herdr")
_HERDR_TIMEOUT: int = 5  # seconds — herdr agent focus is a local server call


def focus_in_herdr(target: str) -> tuple[bool, str]:
    """Focus the target agent inside the Herdr TUI.

    Returns (ok, detail) where *detail* is stderr on failure.
    """
    out = _run([HERDR, "agent", "focus", target], timeout=_HERDR_TIMEOUT)
    if out.returncode != 0:
        detail = "\n".join(part.strip() for part in (out.stdout, out.stderr) if part.strip())
        return False, detail or "herdr agent focus failed"
    return True, ""


def process_has_herdr(pid: int) -> bool:
    """True if the process tree rooted at *pid* contains a process named herdr."""
    seen: set[int] = set()
    stack: list[int] = [pid]
    while stack:
        current = stack.pop()
        if current in seen:
            continue
        seen.add(current)
        try:
            with open(f"/proc/{current}/comm", encoding="utf-8") as handle:
                comm = handle.read().strip()
        except OSError:
            continue
        if comm == "herdr":
            return True
        try:
            task_dir = f"/proc/{current}/task"
            for tid in os.listdir(task_dir):
                try:
                    with open(f"{task_dir}/{tid}/children", encoding="utf-8") as handle:
                        stack.extend(int(child) for child in handle.read().split())
                except OSError:
                    continue
        except OSError:
            continue
    return False


def main(argv: list[str]) -> int:
    if len(argv) not in (1, 2) or not argv[0].strip():
        print(__doc__, file=sys.stderr)
        return 2
    target: str = argv[0].strip()
    window_class: str = argv[1] if len(argv) == 2 else ""

    ok, detail = focus_in_herdr(target)
    herdr_ok: bool = ok
    if not ok:
        print(f"omarchy-herdr-focus: herdr focus: {detail}", file=sys.stderr)

    hl = HyprlandWindow(herdr_checker=process_has_herdr)

    clients = hl.hyprctlClients()
    if clients is None:
        # Not running under Hyprland; the in-TUI focus is all we can do.
        return 0 if herdr_ok else 1

    client = hl.findClient(clients)
    if client is None:
        client = hl.findByClass(clients, window_class)
    if client is None:
        # Headless/remote Herdr; there is no local window to raise.
        return 0 if herdr_ok else 1

    if not hl.ensureVisible(client):
        print(f"omarchy-herdr-focus: could not open "
              f"{client.get('workspace', {}).get('name', 'special workspace')}",
              file=sys.stderr)

    ok, detail = hl.raiseWindow(client["address"])
    if not ok:
        print(f"omarchy-herdr-focus: {detail}", file=sys.stderr)
        return 1 if not herdr_ok else 0
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
